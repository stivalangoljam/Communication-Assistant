rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only YOUR university account may read your messages. Nobody can write from a browser.
    match /items/{id} {
      allow read: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.auth.token.email == 'langoljam.s26204@nst.rishihood.edu.in';
      allow write: if false;
    }

    // Devices that turn on notifications register themselves here. Only you can write; nobody can read from a browser.
    match /devices/{token} {
      allow create, update, delete: if request.auth != null
                  && request.auth.token.email_verified == true
                  && request.auth.token.email == 'langoljam.s26204@nst.rishihood.edu.in';
      allow read: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
